#!/usr/bin/env bash
# End-to-end test of castra against test/fixtures/e2e on one container engine.
#
#   test/e2e/run --engine podman|docker [--keep] [--strict]
#
# Linux only; macOS is tested by hand (issue #1). Needs: castra (or $CASTRA),
# the engine, the devcontainer CLI, git, ssh, ssh-agent, ssh-keygen, scp,
# script, ss, ip, timeout, and sshd (the openssh-server package; its service
# does not have to run). It starts its own ssh-agent with a throwaway key and
# its own sshd on 127.0.0.1, where that key can only fetch the test's dotfiles
# repo, so your agent, your keys and your sshd are never used. It deletes the
# workspace and the images it made unless --keep is given. It touches your
# castra files the way any `castra up` does: a workspace record and a Host
# file, both removed again by `castra delete` at the end, and the Include line
# castra adds once to ~/.ssh/config, which stays. --strict turns every SKIP
# into a FAIL, so no check passes by not running; CI runs with it.
set -uo pipefail

usage() { echo "usage: $0 --engine podman|docker [--keep] [--strict]" >&2; exit 2; }
engine="" keep=0 strict=0
while [ $# -gt 0 ]; do
  case "$1" in
    --engine) engine="$2"; shift 2 ;;
    --keep) keep=1; shift ;;
    --strict) strict=1; shift ;;
    *) usage ;;
  esac
done
case "$engine" in podman|docker) ;; *) usage ;; esac
[ "$(uname)" = Linux ] || { echo "$0: Linux only; macOS is tested by hand (issue #1)" >&2; exit 2; }
# Your agent stays out of it, and cleanup can only ever stop the test's own.
unset SSH_AUTH_SOCK SSH_AGENT_PID

CASTRA="${CASTRA:-castra}"
sshd_bin="$(command -v sshd || echo /usr/sbin/sshd)"
for tool in "$CASTRA" "$engine" git ssh ssh-agent ssh-keygen scp script ss ip timeout; do
  command -v "$tool" >/dev/null || { echo "$0: needs $tool" >&2; exit 2; }
done
[ -x "$sshd_bin" ] || { echo "$0: needs sshd (the openssh-server package; its service does not have to run)" >&2; exit 2; }

here="$(cd "$(dirname "$0")/../.." && pwd)"
name="castra-e2e-$engine"
other=docker; [ "$engine" = docker ] && other=podman
tmp="$(mktemp -d)"
dir="$tmp/$name"
castra_dir="$HOME/.ssh/castra"
failures=0 passes=0 failed=()
# Options for plain ssh and scp, so a Host * in your ~/.ssh/config cannot
# swap in your own agent or a shared connection.
plain=(-o IdentityAgent=SSH_AUTH_SOCK -o ControlMaster=no -o ControlPath=none)

pass() { echo "PASS  $*"; passes=$((passes + 1)); }
fail() {
  echo "FAIL  $*" >&2
  failures=$((failures + 1)); failed+=("$*")
  if [ "${GITHUB_ACTIONS:-}" = true ]; then # an annotation, so the run's summary names the check
    local msg="$*" pct=%
    msg="${msg//$pct/%25}"; msg="${msg//$'\r'/%0D}"; msg="${msg//$'\n'/%0A}"
    echo "::error title=castra e2e on $engine::$msg"
  fi
}
skip() { # skip <description>: a check this machine cannot run; a failure under --strict
  if [ "$strict" = 1 ]; then fail "$* (skipped, and --strict allows no skips)"; else echo "SKIP  $*"; fi
}
check() { # check <description> <command...>: PASS when the command exits 0
  local what="$1"; shift
  if "$@"; then pass "$what"; else fail "$what"; fi
}
refute() { # refute <description> <command...>: PASS when the command fails
  local what="$1"; shift
  if "$@" >/dev/null 2>&1; then fail "$what"; else pass "$what"; fi
}
expect() { # expect <description> <want> <got>
  if [ "$2" = "$3" ]; then pass "$1 ($3)"; else fail "$1: want $2, got $3"; fi
}
# Every call that waits on castra or a session has a time limit, so a hang
# fails the check it happened in instead of the whole job. 300 s covers an
# ssh that has to start the container again first.
in_ws() { timeout 300 "$CASTRA" ssh "$name" -- "$@" </dev/null 2>/dev/null; }
count() { cat -- "$2" 2>/dev/null | grep -c -- "$1"; } # matching lines; 0 for a missing file
ctr_id() { "$engine" ps -a --filter "label=castra.workspace=$name" --format '{{.ID}}'; }
ctr_count() { ctr_id | grep -c .; }
pty() { SHELL="$BASH" timeout 60 script -qec "$(printf '%q ' "$@")" /dev/null | tr -d '\r'; } # run under a terminal
banner() { timeout 5 bash -c 'exec 3<>"/dev/tcp/127.0.0.1/$1" && head -c 7 <&3' _ "$1" 2>/dev/null; }
banner_inside() { in_ws timeout 5 bash -c 'exec 3<>"/dev/tcp/127.0.0.1/$1" && head -c 7 <&3' _ "$1"; }
on_other() { # on_other <when>: the workspace never appears on the engine it was not made with
  local out
  if ! command -v "$other" >/dev/null; then skip "no container on $other $1: $other is not installed here"; return; fi
  if ! out="$("$other" ps -a --filter "label=castra.workspace=$name" --format '{{.ID}}' 2>"$tmp/other.err")"; then
    skip "no container on $other $1: $other ps failed: $(cat "$tmp/other.err")"; return
  fi
  expect "no container on $other $1" 0 "$(grep -c . <<<"$out")"
}

cleanup() {
  if [ "$keep" = 0 ]; then
    timeout 120 "$CASTRA" delete "$name" -y </dev/null >/dev/null 2>&1 || true
    # The images the devcontainer CLI built for this run's folder, which
    # castra delete keeps. Two passes, because the -uid one is built on the other.
    for _ in 1 2; do
      "$engine" images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -F "vsc-$name-" | xargs -r "$engine" rmi >/dev/null 2>&1
    done
  else
    echo "kept: workspace $name, files in $tmp"
  fi
  kill $(jobs -p) 2>/dev/null
  [ -n "${sshd_pid:-}" ] && kill "$sshd_pid" 2>/dev/null
  [ -n "${SSH_AGENT_PID:-}" ] && kill "$SSH_AGENT_PID" 2>/dev/null
  [ "$keep" = 0 ] && rm -rf "$tmp"
}
trap cleanup EXIT

echo "castra e2e on $engine: $("$engine" --version | head -1); $("$CASTRA" version); devcontainer CLI $(devcontainer --version 2>/dev/null || echo unknown); $(. /etc/os-release && echo "$PRETTY_NAME"); user $(id -un) uid $(id -u)"
# Your castra config is read as in any castra run, and two of its settings
# change what some checks prove.
cfg="$("$CASTRA" config path 2>/dev/null)"
if [ -f "$cfg" ] && grep -Eq '^engine:|^[[:space:]]+install:' "$cfg"; then
  echo "NOTE  $cfg sets engine or dotfiles.install: the engine checks or the dotfiles checks may not prove what they say"
fi

# The fixture, copied so the workspace is named after this run. Docker refuses
# the Podman-only z mount option.
cp -r "$here/test/fixtures/e2e" "$dir"
if [ "$engine" = docker ]; then
  sed -i.bak 's/,z"/"/' "$dir/.devcontainer/devcontainer.json" && rm -f "$dir/.devcontainer/devcontainer.json.bak"
fi

# The dotfiles. Their installer records whether the forwarded agent was
# visible while it ran. Your git config, its signing and its hooks stay out.
work="$tmp/dotfiles-work"
mkdir -p "$work"
cat > "$work/install" <<'EOF'
#!/bin/sh
date +%s%N > "$HOME/dotfiles/.installed"
ssh-add -l > "$HOME/dotfiles/.agent-keys" 2>&1 || true
EOF
chmod +x "$work/install"
(
  export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
  git -C "$work" init -q -b main
  git -C "$work" -c user.name=castra -c user.email=castra@example.invalid add . >/dev/null
  git -C "$work" -c user.name=castra -c user.email=castra@example.invalid commit -q -m dotfiles
  git clone -q --bare "$work" "$tmp/dotfiles.git"
)

# A throwaway agent with one key, so forwarding is provable and nothing of
# yours is involved. Its socket lives in the test's folder.
mkdir "$tmp/agent"
eval "$(ssh-agent -s -a "$tmp/agent/sock")" >/dev/null
[ -n "${SSH_AGENT_PID:-}" ] || { echo "$0: ssh-agent did not start" >&2; exit 2; }
ssh-keygen -q -t ed25519 -N '' -C castra-e2e-key -f "$tmp/key"
ssh-add -q "$tmp/key"
export SSH_AUTH_SOCK

# An sshd of the test's own, run as you on 127.0.0.1, where the throwaway key
# can do one thing: fetch the dotfiles repo. The fixture shares this machine's
# network (--network=host), so the container clones the dotfiles from it over
# SSH, which works only through the forwarded agent, and the port forwarding
# checks carry its banner. Without root there is no PAM; Fedora's sshd logs a
# warning about it anyway.
sshd_dir="$tmp/sshd"
mkdir -p "$sshd_dir"
ssh-keygen -q -t ed25519 -N '' -C castra-e2e-sshd -f "$sshd_dir/host_key"
printf 'restrict,command="git-upload-pack %s" %s\n' "'$tmp/dotfiles.git'" "$(cat "$tmp/key.pub")" > "$sshd_dir/authorized_keys"
cat > "$sshd_dir/config" <<EOF
ListenAddress 127.0.0.1
HostKey $sshd_dir/host_key
PidFile $sshd_dir/sshd.pid
AuthorizedKeysFile $sshd_dir/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
StrictModes no
EOF
sshd_port="" sshd_pid=""
for _ in 1 2 3 4 5; do
  port=$((40000 + RANDOM % 10000)) # clear of the forwarding and listener ports below
  [ -n "$(ss -Htln "sport = :$port")" ] && continue
  "$sshd_bin" -D -f "$sshd_dir/config" -p "$port" -E "$sshd_dir/log" &
  sshd_pid=$!
  for _ in $(seq 1 50); do [ "$(banner "$port")" = SSH-2.0 ] && break; sleep 0.1; done
  if [ "$(banner "$port")" = SSH-2.0 ]; then sshd_port="$port"; break; fi
  kill "$sshd_pid" 2>/dev/null; wait "$sshd_pid" 2>/dev/null; sshd_pid=""
done
if [ -z "$sshd_port" ]; then
  echo "$0: the test's own sshd did not start:" >&2
  sed 's/^/  /' "$sshd_dir/log" >&2
  exit 2
fi
remote="ssh://$(id -un)@127.0.0.1:$sshd_port$tmp/dotfiles.git"

# up
t0=$(date +%s)
check "castra up" timeout 600 "$CASTRA" up "$dir" --engine "$engine" --dotfiles "$remote" </dev/null
echo "      (first up took $(( $(date +%s) - t0 )) s)"
ctr="$(ctr_id)"
expect "one container carries the label" 1 "$(ctr_count)"
expect "container is running" true "$("$engine" inspect --format '{{.State.Running}}' "$ctr")"

# ls
ls_json="$(timeout 60 "$CASTRA" ls --json)"
check "ls --json names the workspace" grep -q "\"name\": \"$name\"" <<<"$ls_json"
for k in name state id folder; do
  check "ls --json has $k" grep -q "\"$k\":" <<<"$ls_json"
done
check "ls --json state is running" grep -q '"state": "running"' <<<"$(grep -A1 "\"name\": \"$name\"" <<<"$ls_json")"
check "ls shows it running" grep -Eq "^$name +running " <<<"$(timeout 60 "$CASTRA" ls)"

# An idle session, collected before the container is first stopped. It has to
# outlive OpenSSH's keepalive limit: with ServerAliveInterval 30 and the
# default ServerAliveCountMax 3, a server that never answers is dropped at
# about 120 s.
timeout 200 "$CASTRA" ssh "$name" -- sh -c 'sleep 150; echo ok' </dev/null >"$tmp/idle.out" 2>"$tmp/idle.err" &
idle_pid=$!

# ssh: where, who, and the environment of command and login sessions
expect "pwd is the workspace" "/workspaces/$name" "$(in_ws pwd)"
expect "remote user" vscode "$(in_ws id -un)"
expect "uid matches the host" "$(id -u)" "$(in_ws id -u)"
expect "markers in a command session" "true true $name" "$(in_ws sh -c 'printf "%s %s %s" "$REMOTE_CONTAINERS" "$CASTRA" "$CASTRA_WORKSPACE"')"
expect "remoteEnv in a command session" "yes /opt/fixture/bin" "$(in_ws sh -c 'printf "%s %s" "$CASTRA_FIXTURE_REMOTE" "${PATH##*:}"')"
expect "containerEnv reaches sessions" yes "$(in_ws sh -c 'printf %s "$CASTRA_FIXTURE"')"
login="$(printf 'printf "LOGIN %%s %%s %%s\\n" "$REMOTE_CONTAINERS" "$CASTRA_FIXTURE_REMOTE" "${PATH##*:}"\nexit\n' | timeout 60 "$CASTRA" ssh "$name" 2>/dev/null | tr -d '\r' | grep '^LOGIN ')"
expect "markers and remoteEnv in a login shell" "LOGIN true yes /opt/fixture/bin" "$login"
in_ws sh -c 'exit 3'; expect "exit code passes through" 3 "$?"

# a terminal: under script(1) a command gets a pty, and an interactive shell
# sees the forwarded key and the markers. The typed line never contains the
# marker it prints, so the terminal's echo cannot pass for the answer.
tty_out="$(sleep 3 | pty "$CASTRA" ssh "$name" -- tty)"
check "a command on a terminal gets a pty ($(grep -ao '/dev/pts/[0-9]*' <<<"$tty_out" | head -1))" grep -aq '/dev/pts/[0-9]' <<<"$tty_out"
typed='printf "SHELL%s %s %s %s\n" -CHECK "$(ssh-add -l 2>&1 | grep -c castra-e2e-key)" "$REMOTE_CONTAINERS" "$CASTRA_WORKSPACE"'
shell_out="$({ sleep 3; printf '%s\nexit\n' "$typed"; sleep 3; } | pty "$CASTRA" ssh "$name")"
expect "an interactive shell on a terminal sees the key and the markers" "SHELL-CHECK 1 true $name" "$(grep -ao "SHELL-CHECK [0-9]* [a-z]* $name" <<<"$shell_out" | tail -1)"

# the agent, per session
agent_out="$(in_ws sh -c 'ssh-add -l 2>&1 | grep -c castra-e2e-key; echo "$SSH_AUTH_SOCK"')"
expect "the throwaway key is listed inside" 1 "$(sed -n 1p <<<"$agent_out")"
sock="$(sed -n 2p <<<"$agent_out")"
check "SSH_AUTH_SOCK is a per-session path under /tmp" grep -q '^/tmp/castra-agent-' <<<"$sock"
check "the session socket is gone afterwards" "$engine" exec "$ctr" test -n "$sock" -a ! -e "$sock"
mounts="$("$engine" inspect --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' "$ctr")"
expect "the host agent socket is not mounted" 0 "$({ grep -iE 'auth-agent|ssh_auth|ssh-agent' <<<"$mounts"; grep -F -- "$(dirname "$SSH_AUTH_SOCK")" <<<"$mounts"; } | grep -c .)"
timeout 60 "$CASTRA" ssh "$name" -- sleep 4 </dev/null >/dev/null 2>&1 &
sleep 2
expect "nothing of castra listens on TCP during a session" 0 "$(ss -lntp 2>/dev/null | grep -c castra)"
wait $! 2>/dev/null

# plain OpenSSH, scp both ways, and the files castra wrote for this workspace
check "plain ssh through the Include" timeout 60 ssh "${plain[@]}" "$name.castra" true </dev/null
echo "e2e $(date +%s)" > "$tmp/note.txt"
check "scp into the workspace" timeout 60 scp -q "${plain[@]}" "$tmp/note.txt" "$name.castra:/workspaces/$name/note-in.txt" </dev/null
check "scp back out" timeout 60 scp -q "${plain[@]}" "$name.castra:/workspaces/$name/note-in.txt" "$tmp/note-back.txt" </dev/null
check "the copy is byte-identical" cmp -s "$tmp/note.txt" "$tmp/note-back.txt"
expect "the Host block skips host key checks, as DevPod's does" 1 "$(count 'StrictHostKeyChecking no' "$castra_dir/hosts/$name.conf")"
expect "the Host block keeps no known hosts, as DevPod's does" 1 "$(count 'UserKnownHostsFile /dev/null' "$castra_dir/hosts/$name.conf")"
check "no castra key or pin on the host" test ! -e "$castra_dir/id_ed25519" -a ! -e "$castra_dir/known_hosts" -a ! -e "$castra_dir/known_hosts.d"
check "no host key file in the container" in_ws test ! -e /home/vscode/.castra/host_key

# port forwarding both ways. The fixture runs with --network=host, so a port
# on 127.0.0.1 inside the container is this machine's own; the target is the
# test's sshd, whose banner proves the bytes went through.
lport=$((20000 + RANDOM % 5000)) rport=$((25000 + RANDOM % 5000))
ssh "${plain[@]}" -o ExitOnForwardFailure=yes -N -L "127.0.0.1:$lport:127.0.0.1:$sshd_port" "$name.castra" </dev/null &
lpid=$!
for _ in $(seq 1 50); do [ "$(banner "$lport")" = SSH-2.0 ] && break; sleep 0.1; done
expect "ssh -L carries traffic through the container" SSH-2.0 "$(banner "$lport")"
kill "$lpid" 2>/dev/null; wait "$lpid" 2>/dev/null
ssh "${plain[@]}" -o ExitOnForwardFailure=yes -N -R "127.0.0.1:$rport:127.0.0.1:$sshd_port" "$name.castra" </dev/null &
rpid=$!
for _ in $(seq 1 50); do [ "$(banner_inside "$rport")" = SSH-2.0 ] && break; sleep 0.1; done
expect "ssh -R carries traffic back out of the container" SSH-2.0 "$(banner_inside "$rport")"
kill "$rpid" 2>/dev/null; wait "$rpid" 2>/dev/null
for _ in $(seq 1 20); do
  listener="$(in_ws bash -c 'if (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; then echo open; else echo closed; fi' _ "$rport")"
  [ "$listener" = closed ] && break
  sleep 0.5
done
expect "the -R listener closes with its connection" closed "$listener"

# host networking: a listener started inside the container answers on this
# machine's own address, because the container has no network of its own
host_ip="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')"
if [ -n "$host_ip" ]; then
  hport=$((30000 + RANDOM % 5000))
  timeout 60 "$CASTRA" ssh "$name" -- perl -MIO::Socket::INET -e '
    my $s = IO::Socket::INET->new(LocalAddr => "0.0.0.0", LocalPort => $ARGV[0], Listen => 1, ReuseAddr => 1) or die "listen: $!\n";
    my $c = $s->accept; print $c "hello from $ARGV[1]\n"; close $c' "$hport" "$name" </dev/null >/dev/null 2>&1 &
  hpid=$!
  got=""
  for _ in $(seq 1 50); do
    got="$(timeout 5 bash -c 'exec 3<>"/dev/tcp/$1/$2" && head -1 <&3' _ "$host_ip" "$hport" 2>/dev/null)" && [ -n "$got" ] && break
    sleep 0.2
  done
  expect "a listener inside the container answers on this machine's address $host_ip" "hello from $name" "$got"
  kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
else
  skip "host networking: this machine has no route out to take its address from"
fi

# the fixture's config: mount, lifecycle hooks, ownership
check "bind mount is readable inside" in_ws test -r /mnt/fixture/hello
check "postCreateCommand ran" in_ws test -f /tmp/castra-created
check "postStartCommand ran" in_ws test -f /tmp/castra-started
created="$(in_ws cat /tmp/castra-created)"
in_ws touch "/workspaces/$name/owned"
expect "a file made inside is owned by the host user" "$(id -u)" "$(stat -c %u "$dir/owned")"

# dotfiles over SSH from the test's sshd, which only the throwaway key opens,
# with the agent visible to the installer
check "dotfiles cloned" in_ws test -d /home/vscode/dotfiles/.git
expect "dotfiles came from the SSH remote" "$remote" "$(in_ws git -C /home/vscode/dotfiles remote get-url origin)"
check "the test's sshd let the throwaway key in" grep -q "Accepted publickey for $(id -un) from 127.0.0.1" "$sshd_dir/log"
check "dotfiles installer ran" in_ws test -f /home/vscode/dotfiles/.installed
expect "the agent was forwarded during the install step" 1 "$(in_ws sh -c 'grep -c castra-e2e-key ~/dotfiles/.agent-keys')"
ls_remote='GIT_SSH_COMMAND="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new" git ls-remote "$1"'
check "the remote opens through the forwarded agent" in_ws sh -c "$ls_remote >/dev/null" sh "$remote"
out="$(env -u SSH_AUTH_SOCK timeout 60 "$CASTRA" ssh "$name" -- sh -c "$ls_remote" sh "$remote" </dev/null 2>&1)"; rc=$?
check "the remote refuses a session without the agent (exit $rc)" grep -q 'Permission denied (publickey)' <<<"$out"
installed="$(in_ws cat /home/vscode/dotfiles/.installed)"

# a second up is idempotent and skips the dotfiles
t0=$(date +%s)
out="$(timeout 300 "$CASTRA" up "$dir" --engine "$engine" --dotfiles "$remote" </dev/null 2>&1)"; rc=$?
took=$(( $(date +%s) - t0 ))
expect "second up exits 0" 0 "$rc"
expect "second up keeps the container" "$ctr" "$(ctr_id)"
check "second up skips the dotfiles" grep -q "dotfiles already in" <<<"$out"
expect "dotfiles installer did not rerun" "$installed" "$(in_ws cat /home/vscode/dotfiles/.installed)"
check "second up took under 15 s ($took s)" test "$took" -lt 15
out="$(timeout 300 "$CASTRA" up "$dir" --engine "$other" </dev/null 2>&1)"
check "switching engines is refused" grep -q "runs on $engine;" <<<"$out"

# A workspace keeps its engine: up by name, and an ssh that has to start the
# container again, both find the same container on the same engine. With both
# engines installed castra's default is podman, so on docker this is the
# orphan bug of 2026-10-28 under test.
check "castra up by name" timeout 300 "$CASTRA" up "$name" </dev/null
expect "up by name keeps the container" "$ctr" "$(ctr_id)"
on_other "after up by name"

wait "$idle_pid"
expect "a session idle for 150 s stays connected" ok "$(cat "$tmp/idle.out")"
[ -s "$tmp/idle.err" ] && sed 's/^/      /' "$tmp/idle.err"

"$engine" stop "$ctr" >/dev/null
expect "stopped by $engine itself" false "$("$engine" inspect --format '{{.State.Running}}' "$ctr")"
expect "castra ssh starts it again" back "$(in_ws echo back)"
expect "the ssh restart keeps the container" "$ctr" "$(ctr_id)"
on_other "after an ssh restart"

# stop: the container stops but stays, and up starts the same one again
started="$(in_ws cat /tmp/castra-started)"
check "castra stop" timeout 120 "$CASTRA" stop "$name" </dev/null
expect "container is stopped" false "$("$engine" inspect --format '{{.State.Running}}' "$ctr")"
out="$(timeout 120 "$CASTRA" stop "$name" </dev/null 2>&1)"; rc=$?
expect "second stop exits 0" 0 "$rc"
check "second stop says it is already stopped" grep -q "already stopped" <<<"$out"
check "castra up after stop" timeout 300 "$CASTRA" up "$dir" --engine "$engine" --dotfiles "$remote" </dev/null
expect "up after stop keeps the container" "$ctr" "$(ctr_id)"
restarted="$(in_ws cat /tmp/castra-started)"
check "postStartCommand ran again after stop" test -n "$restarted" -a "$restarted" != "$started"
expect "postCreateCommand did not run again after stop" "$created" "$(in_ws cat /tmp/castra-created)"

# recreate: a new container, create hooks rerun
check "castra up --recreate" timeout 300 "$CASTRA" up "$dir" --engine "$engine" --dotfiles "$remote" --recreate </dev/null
new="$(ctr_id)"
check "recreate changed the container id" test "$new" != "$ctr" -a -n "$new"
expect "still one container" 1 "$(ctr_count)"
recreated="$(in_ws cat /tmp/castra-created)"
check "postCreateCommand ran again" test -n "$recreated" -a "$recreated" != "$created"
check "dotfiles installed in the new container" in_ws test -f /home/vscode/dotfiles/.installed
check "plain ssh reaches the new container" timeout 60 ssh "${plain[@]}" "$name.castra" true </dev/null

# delete: container and records gone, images, volumes and the folder kept
images_before="$("$engine" images -q | sort -u | wc -l)"
volumes_before="$("$engine" volume ls -q | wc -l)"
check "castra delete -y" timeout 120 "$CASTRA" delete "$name" -y </dev/null
expect "no container left" 0 "$(ctr_count)"
check "no Host file left" test ! -e "$castra_dir/hosts/$name.conf"
check "the folder is untouched" test -f "$dir/.devcontainer/devcontainer.json" -a -f "$dir/owned"
expect "images untouched" "$images_before" "$("$engine" images -q | sort -u | wc -l)"
expect "volumes untouched" "$volumes_before" "$("$engine" volume ls -q | wc -l)"
ls_out="$(timeout 60 "$CASTRA" ls 2>&1)"; rc=$?
check "ls no longer lists it" test "$rc" = 0 -a -z "$(grep "^$name " <<<"$ls_out")"

echo
if [ "$failures" = 0 ]; then
  echo "castra e2e on $engine: all $passes checks passed"
else
  echo "castra e2e on $engine: $failures of $((passes + failures)) checks failed:" >&2
  printf '  %s\n' "${failed[@]}" >&2
  echo "the test's sshd log, last lines:" >&2
  tail -n 20 "$sshd_dir/log" | sed 's/^/  /' >&2
  exit 1
fi
