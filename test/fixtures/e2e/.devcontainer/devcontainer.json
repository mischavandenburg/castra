{
  // The shape castra is tested against: a Dockerfile build, a non-root user,
  // host networking, labels off, a bind mount with the z option, container
  // env, and both lifecycle hooks.
  "name": "castra e2e",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "runArgs": ["--network=host", "--security-opt", "label=disable"],
  "containerEnv": { "CASTRA_FIXTURE": "yes" },
  "mounts": [
    "source=${localWorkspaceFolder}/mounted,target=/mnt/fixture,type=bind,z"
  ],
  "postCreateCommand": "date +%s%N > /tmp/castra-created",
  "postStartCommand": "date +%s%N > /tmp/castra-started"
}
